;;; gen-module-requires.el --- Generate my/init-module-requires -*- lexical-binding: t; -*-

;; Regenerates the module dependency block of init.el from the
;; ";; Requires:" header comments of each module, so contributors edit one
;; place.  The block sits between the "BEGIN generated" and "END generated"
;; marker comments inside `my/init-module-requires'.
;;
;; Check (prints a diff and exits 1 when init.el is stale):
;;   emacs --batch -Q -l scripts/gen-module-requires.el \
;;         --eval "(my/gen-module-requires-main)"
;; Rewrite init.el:
;;   emacs --batch -Q -l scripts/gen-module-requires.el \
;;         --eval "(my/gen-module-requires-main t)"

(require 'cl-lib)

(defconst my/gen-requires--root
  (file-name-as-directory
   (expand-file-name ".." (file-name-directory
                           (or load-file-name buffer-file-name))))
  "Repository root.")

(defconst my/gen-requires--begin ";; BEGIN generated by scripts/gen-module-requires.el")
(defconst my/gen-requires--end ";; END generated")

(defun my/gen-requires-modules (&optional root)
  "Return the module list read from `my/init-modules-default' in ROOT/init.el."
  (with-temp-buffer
    (insert-file-contents (expand-file-name "init.el" (or root my/gen-requires--root)))
    (goto-char (point-min))
    (re-search-forward "^(defconst my/init-modules-default")
    (goto-char (match-beginning 0))
    (cadr (nth 2 (read (current-buffer))))))

(defun my/gen-requires-declared (module &optional root)
  "Return modules named on \"Requires:\" comment lines of MODULE's source."
  (let* ((root (or root my/gen-requires--root))
         (file (car (mapcan
                     (lambda (dir)
                       (directory-files-recursively
                        (expand-file-name dir root)
                        (format "\\`%s\\.el\\'" module)))
                     '("core" "kernel" "modules"))))
         (found nil))
    (when file
      (with-temp-buffer
        (insert-file-contents file)
        (goto-char (point-min))
        (while (re-search-forward "^;; Requires: \\(.*\\)$" nil t)
          (let ((line (match-string 1))
                (start 0))
            (while (string-match "\\binit-[a-z-]+\\b" line start)
              (push (intern (match-string 0 line)) found)
              (setq start (match-end 0)))))))
    (cl-remove-duplicates (nreverse found))))

(defun my/gen-requires-block (&optional root)
  "Return the generated record lines (a string) for ROOT."
  (mapconcat
   (lambda (module)
     (format "    (%-19s. (%s))" module
             (mapconcat #'symbol-name (my/gen-requires-declared module root) " ")))
   (cl-remove-if-not (lambda (module) (my/gen-requires-declared module root))
                     (my/gen-requires-modules root))
   "\n"))

(defun my/gen-requires-current (&optional root)
  "Return the record lines currently between the markers in ROOT/init.el."
  (with-temp-buffer
    (insert-file-contents (expand-file-name "init.el" (or root my/gen-requires--root)))
    (goto-char (point-min))
    (search-forward my/gen-requires--begin)
    (forward-line 1)
    (let ((start (point)))
      (search-forward my/gen-requires--end)
      (forward-line 0)
      (string-trim-right (buffer-substring-no-properties start (point))))))

(defun my/gen-module-requires-main (&optional write)
  "Compare the generated block with init.el; rewrite init.el when WRITE.
In check mode, print a diff and exit with status 1 when they differ."
  (let ((generated (my/gen-requires-block))
        (current (my/gen-requires-current))
        (init (expand-file-name "init.el" my/gen-requires--root)))
    (cond
     ((string= generated current)
      (message "my/init-module-requires is up to date"))
     (write
      (with-temp-buffer
        (insert-file-contents init)
        (goto-char (point-min))
        (search-forward my/gen-requires--begin)
        (forward-line 1)
        (let ((start (point)))
          (search-forward my/gen-requires--end)
          (forward-line 0)
          (delete-region start (point))
          (insert generated "\n"))
        (write-region (point-min) (point-max) init nil 'silent))
      (message "rewriting block in %s" init))
     (t
      (let ((a (make-temp-file "requires-current"))
            (b (make-temp-file "requires-generated")))
        (write-region (concat current "\n") nil a nil 'silent)
        (write-region (concat generated "\n") nil b nil 'silent)
        (when (executable-find "diff")
          (princ (with-temp-buffer
                   (call-process "diff" nil t nil "-u" a b)
                   (buffer-string))))
        (delete-file a)
        (delete-file b))
      (message "my/init-module-requires is stale; run with (my/gen-module-requires-main t)")
      (kill-emacs 1)))))

;;; gen-module-requires.el ends here
